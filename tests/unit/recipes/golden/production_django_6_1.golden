PATHS:
  .dockerignore
  .env.example
  Dockerfile
  api/__init__.py
  api/apps.py
  api/models.py
  api/tests.py
  api/urls.py
  api/views.py
  core/__init__.py
  core/apps.py
  core/models.py
  core/tests.py
  core/urls.py
  core/views.py
  docker-compose.yml
  manage.py
  requirements.txt
  testproject/__init__.py
  testproject/asgi.py
  testproject/health.py
  testproject/settings.py
  testproject/settings/__init__.py
  testproject/settings/base.py
  testproject/settings/local.py
  testproject/settings/production.py
  testproject/urls.py
  testproject/wsgi.py

REQUIREMENTS:
  Django<6.2,>=6.1.1
  gunicorn>=26.2.0,<27

--- Dockerfile ---
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN DJANGO_SETTINGS_MODULE=testproject.settings.local python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["gunicorn", "testproject.wsgi:application", "--bind", "0.0.0.0:8000"]

--- api/urls.py ---
from django.urls import path
from . import views

app_name = 'api'

urlpatterns = [
    path('', views.home, name='home'),
]

--- core/urls.py ---
from django.urls import path
from . import views

app_name = 'core'

urlpatterns = [
    path('', views.home, name='home'),
]

--- docker-compose.yml ---
services:
  web:
    build: .
    ports:
      - "8000:8000"
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE=testproject.settings.production

--- manage.py ---
#!/usr/bin/env python
"""Django's command-line utility for administrative tasks."""
import os
import sys


def main():
    """Run administrative tasks."""
    os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'testproject.settings.local')
    try:
        from django.core.management import execute_from_command_line
    except ImportError as exc:
        raise ImportError(
            "Couldn't import Django. Are you sure it's installed and "
            "available on your PYTHONPATH environment variable? Did you "
            "forget to activate a virtual environment?"
        ) from exc
    execute_from_command_line(sys.argv)


if __name__ == '__main__':
    main()

